<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/nav_bar_height"
    android:background="@color/nav_bar_bg"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="@dimen/padding_medium"
    android:weightSum="4">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/nav_back"
        style="@style/Widget.MaterialComponents.Button.Icon"
        android:layout_width="0dp"
        android:layout_height="@dimen/nav_bar_icon_height"
        android:layout_weight="1"
        android:contentDescription="返回"
        app:icon="@drawable/ic_back"
        app:iconSize="@dimen/nav_bar_icon_size" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/nav_home"
        style="@style/Widget.MaterialComponents.Button.Icon"
        android:layout_width="0dp"
        android:layout_height="@dimen/nav_bar_icon_height"
        android:layout_weight="1"
        android:contentDescription="主页"
        app:icon="@drawable/ic_home"
        app:iconSize="@dimen/nav_bar_icon_size" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/nav_recent"
        style="@style/Widget.MaterialComponents.Button.Icon"
        android:layout_width="0dp"
        android:layout_height="@dimen/nav_bar_icon_height"
        android:layout_weight="1"
        android:contentDescription="最近任务"
        app:icon="@drawable/ic_recent"
        app:iconSize="@dimen/nav_bar_icon_size" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/nav_drawer"
        style="@style/Widget.MaterialComponents.Button.Icon"
        android:layout_width="0dp"
        android:layout_height="@dimen/nav_bar_icon_height"
        android:layout_weight="1"
        android:contentDescription="应用抽屉"
        app:icon="@drawable/ic_apps"
        app:iconSize="@dimen/nav_bar_icon_size" />

</LinearLayout>
