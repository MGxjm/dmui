<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark_light"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/padding_medium"
        android:weightSum="3">

        <SearchView
            android:id="@+id/drawer_search"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="2"
            android:background="@color/background_card"
            android:queryHint="搜索应用..."
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/drawer_sort"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginLeft="@dimen/padding_medium"
            android:background="@color/primary"
            android:text="@string/drawer_sort_name"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/drawer_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="@dimen/padding_medium" />

    <ImageView
        android:id="@+id/drawer_close"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/padding_large"
        android:src="@drawable/ic_close"
        android:contentDescription="关闭" />

</LinearLayout>