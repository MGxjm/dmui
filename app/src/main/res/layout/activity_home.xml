<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:orientation="vertical">

    <com.carlauncher.ui.components.StatusBarView
        android:id="@+id/status_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/status_bar_height" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="@dimen/padding_large">

            <com.carlauncher.ui.components.ClockWeatherView
                android:id="@+id/clock_weather"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.carlauncher.ui.components.QuickAppsView
                android:id="@+id/quick_apps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_large" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/padding_large">

            <Button
                android:id="@+id/settings_button"
                android:layout_width="@dimen/button_min_size"
                android:layout_height="@dimen/button_min_size"
                android:layout_marginBottom="@dimen/padding_small"
                android:background="@drawable/ic_settings" />

            <Button
                android:id="@+id/car_control_button"
                android:layout_width="@dimen/button_min_size"
                android:layout_height="@dimen/button_min_size"
                android:layout_marginBottom="@dimen/padding_small"
                android:background="@drawable/ic_car" />

            <Button
                android:id="@+id/display_control_button"
                android:layout_width="@dimen/button_min_size"
                android:layout_height="@dimen/button_min_size"
                android:layout_marginBottom="@dimen/padding_small"
                android:background="@drawable/ic_display" />

            <Button
                android:id="@+id/floating_map_button"
                android:layout_width="@dimen/button_min_size"
                android:layout_height="@dimen/button_min_size"
                android:layout_marginBottom="@dimen/padding_small"
                android:background="@drawable/ic_map" />

            <Button
                android:id="@+id/permission_button"
                android:layout_width="@dimen/button_min_size"
                android:layout_height="@dimen/button_min_size"
                android:background="@drawable/ic_permission" />
        </LinearLayout>
    </LinearLayout>

    <com.carlauncher.ui.components.NavBarView
        android:id="@+id/nav_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nav_bar_height" />

    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <com.carlauncher.ui.components.AppDrawer
            android:id="@+id/app_drawer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.carlauncher.ui.components.NotificationPanel
            android:id="@+id/notification_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.carlauncher.ui.components.CarControlPanel
            android:id="@+id/car_control_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.carlauncher.ui.components.DisplayControlPanel
            android:id="@+id/display_control_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

</LinearLayout>