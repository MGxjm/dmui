<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <com.carlauncher.ui.components.StatusBarView
        android:id="@+id/status_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/status_bar_height"
        android:layout_alignParentTop="true" />

    <com.carlauncher.ui.components.ClockWeatherView
        android:id="@+id/clock_weather"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/status_bar"
        android:layout_centerHorizontal="true"
        android:padding="@dimen/padding_large" />

    <ImageButton
        android:id="@+id/settings_button"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_marginTop="@dimen/padding_large"
        android:layout_marginRight="@dimen/padding_large"
        android:background="@drawable/ic_settings"
        android:contentDescription="@string/settings_title" />

    <com.carlauncher.ui.components.QuickAppsView
        android:id="@+id/quick_apps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/clock_weather"
        android:layout_centerHorizontal="true"
        android:padding="@dimen/padding_large" />

    <com.carlauncher.ui.components.NavBarView
        android:id="@+id/nav_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nav_bar_height"
        android:layout_alignParentBottom="true" />

    <com.carlauncher.ui.components.AppDrawer
        android:id="@+id/app_drawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/status_bar"
        android:layout_above="@id/nav_bar" />

    <com.carlauncher.ui.components.NotificationPanel
        android:id="@+id/notification_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/status_bar" />

</RelativeLayout>