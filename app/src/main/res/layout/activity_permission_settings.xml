<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:orientation="vertical"
    android:padding="@dimen/padding_large">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="权限管理"
        android:textColor="@color/text_primary"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginBottom="@dimen/padding_large" />

    <!-- ADB权限 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background_card"
        android:orientation="vertical"
        android:padding="@dimen/padding_medium"
        android:layout_marginBottom="@dimen/padding_medium">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ADB权限"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/adb_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="未授权"
                android:textColor="@color/error"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="用于执行车机控制命令"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="@dimen/padding_small"
            android:layout_marginBottom="@dimen/padding_medium" />

        <Button
            android:id="@+id/request_adb_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="申请ADB权限"
            android:textSize="16sp"
            android:background="@color/primary" />
    </LinearLayout>

    <!-- 无障碍权限 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background_card"
        android:orientation="vertical"
        android:padding="@dimen/padding_medium"
        android:layout_marginBottom="@dimen/padding_medium">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="无障碍服务"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/accessibility_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="未授权"
                android:textColor="@color/error"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="用于系统级交互控制"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="@dimen/padding_small"
            android:layout_marginBottom="@dimen/padding_medium" />

        <Button
            android:id="@+id/request_accessibility_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="申请无障碍权限"
            android:textSize="16sp"
            android:background="@color/primary" />
    </LinearLayout>

    <!-- 悬浮窗权限 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background_card"
        android:orientation="vertical"
        android:padding="@dimen/padding_medium">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="悬浮窗权限"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/floating_window_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="未授权"
                android:textColor="@color/error"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="用于地图悬浮显示"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="@dimen/padding_small"
            android:layout_marginBottom="@dimen/padding_medium" />

        <Button
            android:id="@+id/request_floating_window_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="申请悬浮窗权限"
            android:textSize="16sp"
            android:background="@color/primary" />
    </LinearLayout>

</LinearLayout>
