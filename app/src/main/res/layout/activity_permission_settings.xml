<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:padding="@dimen/padding_large">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/permission_management"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/title_size"
            android:textStyle="bold" />

        <!-- ADB权限 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_large"
            android:background="@color/background_card"
            android:orientation="vertical"
            android:padding="@dimen/padding_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ADB Shell 权限"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/subtitle_size" />

                <TextView
                    android:id="@+id/adb_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="未连接"
                    android:textColor="@color/error"
                    android:textSize="@dimen/body_size" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_small"
                android:text="通过 adb connect 127.0.0.1:5555 获取Shell权限，需先在开发者选项中开启无线调试并通过电脑配对授权"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/body_size" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_medium"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/request_adb_button"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/control_button_height"
                    android:layout_weight="1"
                    android:layout_marginRight="@dimen/padding_small"
                    android:text="打开开发者选项" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/connect_adb_button"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/control_button_height"
                    android:layout_weight="1"
                    android:text="连接 ADB" />
            </LinearLayout>
        </LinearLayout>

        <!-- 无障碍权限 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_medium"
            android:background="@color/background_card"
            android:orientation="vertical"
            android:padding="@dimen/padding_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="无障碍服务"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/subtitle_size" />

                <TextView
                    android:id="@+id/accessibility_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="未授权"
                    android:textColor="@color/error"
                    android:textSize="@dimen/body_size" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_small"
                android:text="用于实现返回键、最近任务等系统级操作"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/body_size" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/request_accessibility_button"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/control_button_height"
                android:layout_marginTop="@dimen/padding_medium"
                android:text="开启无障碍服务" />
        </LinearLayout>

        <!-- 悬浮窗权限 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_medium"
            android:background="@color/background_card"
            android:orientation="vertical"
            android:padding="@dimen/padding_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="悬浮窗权限"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/subtitle_size" />

                <TextView
                    android:id="@+id/floating_window_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="未授权"
                    android:textColor="@color/error"
                    android:textSize="@dimen/body_size" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_small"
                android:text="用于显示悬浮地图窗口"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/body_size" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/request_floating_window_button"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/control_button_height"
                android:layout_marginTop="@dimen/padding_medium"
                android:text="开启悬浮窗权限" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
