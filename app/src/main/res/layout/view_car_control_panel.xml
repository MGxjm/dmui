<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark_light"
    android:orientation="vertical"
    android:padding="@dimen/control_panel_padding">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/car_control_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/title_size"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/padding_large">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 空调控制 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_medium">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/air_condition_control"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/subtitle_size"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/padding_medium"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/ac_power_button"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/control_button_height"
                        android:layout_weight="1"
                        android:layout_marginRight="@dimen/padding_small"
                        android:text="@string/ac_power" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/temp_up_button"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/control_button_height"
                        android:layout_weight="1"
                        android:layout_marginRight="@dimen/padding_small"
                        android:text="@string/temp_up" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/temp_down_button"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/control_button_height"
                        android:layout_weight="1"
                        android:text="@string/temp_down" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/padding_small"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/fan_up_button"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/control_button_height"
                        android:layout_weight="1"
                        android:layout_marginRight="@dimen/padding_small"
                        android:text="@string/fan_up" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/fan_down_button"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/control_button_height"
                        android:layout_weight="1"
                        android:layout_marginRight="@dimen/padding_small"
                        android:text="@string/fan_down" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/ac_mode_button"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/control_button_height"
                        android:layout_weight="1"
                        android:text="@string/ac_mode" />
                </LinearLayout>
            </LinearLayout>

            <!-- 车窗控制 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/control_section_spacing"
                android:orientation="vertical"
                android:padding="@dimen/padding_medium">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/window_control"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/subtitle_size"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/padding_medium"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/window_front_up"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/control_button_height"
                        android:layout_weight="1"
                        android:layout_marginRight="@dimen/padding_small"
                        android:text="@string/window_front_up" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/window_front_down"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/control_button_height"
                        android:layout_weight="1"
                        android:layout_marginRight="@dimen/padding_small"
                        android:text="@string/window_front_down" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/window_rear_up"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/control_button_height"
                        android:layout_weight="1"
                        android:layout_marginRight="@dimen/padding_small"
                        android:text="@string/window_rear_up" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/window_rear_down"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/control_button_height"
                        android:layout_weight="1"
                        android:text="@string/window_rear_down" />
                </LinearLayout>
            </LinearLayout>

            <!-- 天窗/后备箱 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/control_section_spacing"
                android:orientation="vertical"
                android:padding="@dimen/padding_medium">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/other_control"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/subtitle_size"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/padding_medium"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/sunroof_open"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/control_button_height"
                        android:layout_weight="1"
                        android:layout_marginRight="@dimen/padding_small"
                        android:text="@string/sunroof_open" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/sunroof_close"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/control_button_height"
                        android:layout_weight="1"
                        android:layout_marginRight="@dimen/padding_small"
                        android:text="@string/sunroof_close" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/trunk_open"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/control_button_height"
                        android:layout_weight="1"
                        android:text="@string/trunk_open" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>
