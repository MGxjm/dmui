<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/status_bar_height"
    android:background="@color/status_bar_bg"
    android:padding="@dimen/padding_medium">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentLeft="true"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/status_bar_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_bar_time"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/status_bar_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status_bar_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_bar_date"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/body_size" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentRight="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/status_bar_wifi_icon"
            android:layout_width="@dimen/status_bar_icon_size"
            android:layout_height="@dimen/status_bar_icon_size"
            android:layout_marginLeft="@dimen/padding_medium"
            android:src="@drawable/ic_wifi"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/status_bar_bluetooth_icon"
            android:layout_width="@dimen/status_bar_icon_size"
            android:layout_height="@dimen/status_bar_icon_size"
            android:layout_marginLeft="@dimen/padding_medium"
            android:src="@drawable/ic_bluetooth"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/status_bar_battery_icon"
            android:layout_width="@dimen/status_bar_icon_size"
            android:layout_height="@dimen/status_bar_icon_size"
            android:layout_marginLeft="@dimen/padding_medium"
            android:src="@drawable/ic_battery_full" />

        <TextView
            android:id="@+id/status_bar_battery_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/padding_small"
            android:text="100%"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/body_size" />
    </LinearLayout>

</RelativeLayout>
