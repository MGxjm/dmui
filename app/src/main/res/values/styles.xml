<resources>
    <style name="Theme.CarLauncher" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/status_bar_bg</item>
        <item name="android:navigationBarColor">@color/nav_bar_bg</item>
    </style>

    <style name="Theme.CarLauncher.Fullscreen" parent="Theme.CarLauncher">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="TextAppearance.Clock" parent="android:TextAppearance.Material.Display1">
        <item name="android:textSize">@dimen/clock_size</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-light</item>
    </style>

    <style name="TextAppearance.Date" parent="android:TextAppearance.Material.Subhead">
        <item name="android:textSize">@dimen/date_size</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Widget.Card" parent="android:Widget.Material.CardView">
        <item name="android:background">@color/background_card</item>
        <item name="android:elevation">8dp</item>
        <item name="android:radius">@dimen/card_radius</item>
    </style>

    <style name="Widget.NavButton">
        <item name="android:minWidth">@dimen/button_min_size</item>
        <item name="android:minHeight">@dimen/button_min_size</item>
        <item name="android:padding">@dimen/padding_small</item>
        <item name="android:scaleType">centerInside</item>
    </style>
</resources>